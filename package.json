{
  "name": "octal-shop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3001 --turbopack",
    "staging": "next build && next start -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "deps": "ncu -i --format group",
    "deps:check": "ncu --format group",
    "deps:minor": "ncu -i --target minor",
    "deps:patch": "ncu -i --target patch",
    "deps:doctor": "ncu --doctor -u",
    "deps:peer": "ncu --peer",
    "tree": "treee -I \"node_modules|.git|.idea|target|build|dist|dev-dist|bin|.project-structure.txt\" -a --dirs-first",
    "tree:export": "npm run tree --silent > .project-structure.txt"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@tabler/icons-react": "^3.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^12.38.0",
    "next": "16.2.6",
    "next-intl": "^4.11.1",
    "next-themes": "^0.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "npm-check-updates": "^22.1.1",
    "postcss": "^8.5.14",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "tree-node-cli": "^3.0.0",
    "typescript": "^6",
    "typescript-eslint": "^8.59.2"
  }
}
