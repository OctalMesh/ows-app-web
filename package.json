{
  "name": "ows-app-web",
  "version": "0.1.0",
  "description": "Frontend application for OctalWeb-Shop",
  "author": "OctalMesh <contact@octalmesh.com> (https://octalmesh.com)",
  "license": "MIT",
  "homepage": "https://octalmesh.com",
  "type": "module",
  "private": true,
  "keywords": [
    "octalmesh",
    "octalweb",
    "shop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OctalMesh/ows-app-web.git"
  },
  "bugs": {
    "url": "https://github.com/OctalMesh/ows-app-web/issues",
    "email": "security@octalmesh.com"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "next dev -p 3001 --turbopack",
    "dev:inspect": "pnpm run dev --inspect",
    "staging": "next build && next start -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "deps": "ncu -i --format group",
    "deps:check": "ncu --format group",
    "deps:minor": "ncu -i --target minor",
    "deps:patch": "ncu -i --target patch",
    "deps:doctor": "ncu --doctor -u",
    "deps:peer": "ncu --peer",
    "tree": "treee -I \"node_modules|.next|.git|.idea|target|build|dist|dev-dist|bin|.project-structure.txt\" -a --dirs-first",
    "tree:export": "pnpm run tree --silent > .project-structure.txt"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.2",
    "@shadcn/react": "^0.3.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "@types/mdx": "^2.0.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "estree-util-value-to-estree": "^3.5.0",
    "hast-util-to-string": "^3.0.1",
    "input-otp": "^1.5.0",
    "jose": "^6.2.9",
    "matter-js": "^0.20.0",
    "motion": "^13.1.1",
    "next": "16.3.2",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-hotkeys-hook": "^5.3.3",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/estree": "^1.0.9",
    "@types/hast": "^3.0.5",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "jsdom": "^30.0.1",
    "npm-check-updates": "^23.0.2",
    "postcss": "^8.5.26",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tree-node-cli": "^3.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
